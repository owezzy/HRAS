# Production environment variables (Cloudflare Workers)
# NEXT_PUBLIC_* values are inlined at build time
NEXT_PUBLIC_API_URL=https://hras-api.owenadirah.com
NEXT_PUBLIC_BASE_URL=https://hras.owenadirah.com

# AUTH_URL is also set in wrangler.jsonc; AUTH_SECRET is a Worker secret (`npx wrangler secret put AUTH_SECRET`)
AUTH_URL=https://hras.owenadirah.com
