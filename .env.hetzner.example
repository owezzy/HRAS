DOMAIN=hetzner-api.hras.example.com
LETSENCRYPT_EMAIL=admin@owezzy.tech
FRONTEND_DOMAIN=https://hras.owezzy.tech

APP_NAME=hras
APP_VERSION=latest
APP_ENV=production
DEBUG=false

BACKEND_PORT=8000
POSTGRES_PORT=5432
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100

DATABASE_URL=postgresql+asyncpg://hras:CHANGE_ME_SECURE_PASSWORD@postgres:5432/hras
POSTGRES_DB=hras
POSTGRES_USER=hras
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD

SECRET_KEY=CHANGE_ME_SECRET_KEY_64_CHARS_MINIMUM
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY_64_CHARS_MINIMUM
HEALTH_CHECK_TOKEN=
ALLOWED_SSH_CIDR=0.0.0.0/0
SWAP_SIZE_GB=8

CORS_ORIGINS='["https://hras.owezzy.tech"]'
TRUSTED_HOSTS='["localhost","127.0.0.1","backend","backend:8000","hetzner-api.hras.example.com"]'

USE_POSTGRES=true
USE_ASYNC_TOOLS=true
USE_LANGSMITH_TRACING=true
ENABLE_PRODUCTION_EVALUATIONS=false
BACKUP_BEFORE_DEPLOY=true
BACKUP_RETENTION_DAYS=30
ROLLBACK_ON_FAILURE=true
HEALTH_CHECK_TIMEOUT=300

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=nemotron-3-nano:30b-cloud
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=180

CHROMA_PERSIST_DIRECTORY=/app/chroma_db

LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hras-production
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
NOTIFICATION_WEBHOOK=
