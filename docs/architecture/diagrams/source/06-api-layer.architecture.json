  "cards": [
    {
      "dot": "rose",
      "title": "Order",
      "items": [
        "Starlette runs the last-added middleware first, so CORS sees every request first",
        "TrustedHost is added only when APP_ENV is production"
      ]
    },
    {
      "dot": "slate",
      "title": "Prefixes",
      "items": [
        "Chat, admin and conversations mount under /api/v1",
        "Health and / sit at the root; /metrics is a mounted Prometheus app"
      ]
    }
