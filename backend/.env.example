# =============================================================================
# HRAS Backend Environment Variables
# Copy this file to .env and customize for your environment
# SECURITY: Never commit .env files with real credentials!
# =============================================================================

# Application
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./hras.db

# Chat LLM (OpenAI-compatible). LLM_PROVIDER: deepseek | openai | openrouter | ollama | custom
# Leave LLM_BASE_URL / LLM_MODEL blank to use the provider preset.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=180
LLM_TEMPERATURE=0.1

# Embeddings (OpenAI-compatible, configured SEPARATELY from chat).
# DeepSeek, OpenRouter and Ollama Cloud serve chat but expose NO embeddings.
# EMBEDDING_BASE_URL must point at a host serving nomic-embed-text-v1.5, which is
# the model the existing ChromaDB index was built with. Changing the model
# invalidates the index and requires re-ingesting the full UHRI corpus.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text-v1.5

# Vector Store
CHROMA_PERSIST_DIRECTORY=./chroma_db

# UHRI API
UHRI_API_URL=https://uhri.ohchr.org/api
UHRI_API_TIMEOUT=30

# CORS Origins (JSON array or comma-separated)
# Include Amplify frontend URL for production
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Security Settings (use JSON arrays for list fields)
TRUSTED_HOSTS=["localhost","127.0.0.1"]
DOCS_ENABLED=true

# Feature Flags
USE_POSTGRES=false
USE_ASYNC_TOOLS=true

# LangSmith Tracing & Evaluation
USE_LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hras-development
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
ENABLE_PRODUCTION_EVALUATIONS=false
