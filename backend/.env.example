# =============================================================================
# HRAS Backend Environment Variables
# Copy this file to .env and customize for your environment
# SECURITY: Never commit .env files with real credentials!
# =============================================================================

# Application
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./hras.db

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nemotron-3-nano:30b-cloud
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=180

# Vector Store
CHROMA_PERSIST_DIRECTORY=./chroma_db

# UHRI API
UHRI_API_URL=https://uhri.ohchr.org/api
UHRI_API_TIMEOUT=30

# CORS Origins (JSON array or comma-separated)
# Include Amplify frontend URL for production
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Security Settings (use JSON arrays for list fields)
TRUSTED_HOSTS=["localhost","127.0.0.1"]
DOCS_ENABLED=true

# Feature Flags
USE_POSTGRES=false
USE_ASYNC_TOOLS=true

# LangSmith Tracing & Evaluation
USE_LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hras-development
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
ENABLE_PRODUCTION_EVALUATIONS=false
