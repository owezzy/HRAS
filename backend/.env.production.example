# =============================================================================
# HRAS Production Environment Configuration Template
# =============================================================================
# SECURITY WARNING: Never commit this file with real values to version control!
# Copy to .env.production and fill in the actual values securely.
# =============================================================================

# Application Settings
APP_ENV=production
DEBUG=false
APP_VERSION=0.2.0

# Domain Configuration
DOMAIN=api.yourdomain.com
AMPLIFY_FRONTEND_URL=https://main.d1234abcd.amplifyapp.com

# CORS Configuration (Amplify frontend domain)
CORS_ORIGINS=["https://main.d1234abcd.amplifyapp.com","https://yourdomain.com"]

# Trusted Hosts (for Host header validation)
TRUSTED_HOSTS=api.yourdomain.com,www.api.yourdomain.com

# API Documentation (disable in production)
DOCS_ENABLED=false

# Database Configuration
# For SQLite (simple deployment):
DATABASE_URL=sqlite+aiosqlite:///./data/hras.db

# For PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# POSTGRES_DB=hras
# POSTGRES_USER=hras
# POSTGRES_PASSWORD=<GENERATE_SECURE_PASSWORD_HERE>

# LLM Configuration (Ollama)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=nemotron-3-nano:30b-cloud
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=180

# Vector Store
CHROMA_PERSIST_DIRECTORY=/app/data/chroma_db

# Feature Flags
USE_POSTGRES=false
USE_ASYNC_TOOLS=true

# SSL/TLS Configuration (Certbot with Route53)
CERTBOT_EMAIL=admin@yourdomain.com
AWS_DEFAULT_REGION=us-east-1

# AWS Credentials for Route53 DNS Challenge
# SECURITY: Use IAM Instance Profile instead of static credentials when possible
# If using static credentials, ensure they have minimal permissions (Route53 only)
# AWS_ACCESS_KEY_ID=<YOUR_ACCESS_KEY_ID>
# AWS_SECRET_ACCESS_KEY=<YOUR_SECRET_ACCESS_KEY>

# Health Check Token (optional additional security for Route53 health checks)
# HEALTH_CHECK_TOKEN=<GENERATE_RANDOM_TOKEN_HERE>

# Redis Configuration (if using Redis for caching)
# REDIS_PASSWORD=<GENERATE_SECURE_PASSWORD_HERE>
# REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# Monitoring
# GRAFANA_ADMIN_PASSWORD=<GENERATE_SECURE_PASSWORD_HERE>

# Logging
LOG_LEVEL=INFO

# Data Paths (for Docker volume mounts)
DATA_PATH=./data
LOGS_PATH=./data/logs
SSL_CERT_PATH=./data/certbot
