# =============================================================================
# HRAS Production Environment Configuration
# =============================================================================

# Domain Configuration
DOMAIN=api.hras.example.com
FRONTEND_DOMAIN=feature-backend-refactor-testing.d3q35zh7ig6w8u.amplifyapp.com

# Version and Build Information
VERSION=1.0.0
BUILD_DATE=2024-01-16T10:00:00Z
VCS_REF=main

# SSL/TLS Configuration
CERTBOT_EMAIL=admin@hras.example.com
SSL_CERT_PATH=/opt/hras/data/certbot
NOTIFICATION_WEBHOOK=https://hooks.slack.com/your/webhook/url

# AWS Configuration for Route53 DNS Challenge
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=us-east-1

# Data and Logs Paths
DATA_PATH=/opt/hras/data
LOGS_PATH=/opt/hras/logs

# Database Configuration
DATABASE_URL=postgresql+asyncpg://hras:secure_password@postgres:5432/hras
POSTGRES_DB=hras
POSTGRES_USER=hras
POSTGRES_PASSWORD=secure_password

# Redis Configuration
REDIS_PASSWORD=secure_redis_password

# Backend Configuration
SECRET_KEY=your-secret-key-here-64-chars-minimum-for-security
JWT_SECRET_KEY=your-jwt-secret-key-here-also-64-chars-minimum
HEALTH_CHECK_TOKEN=random-token-for-health-checks

# CORS Configuration for AWS Amplify
CORS_ORIGINS=["https://feature-backend-refactor-testing.d3q35zh7ig6w8u.amplifyapp.com","http://localhost:3000"]

# Feature Flags
USE_POSTGRES=true
USE_ASYNC_TOOLS=true
ENABLE_METRICS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Ollama Configuration (External Service)
OLLAMA_BASE_URL=http://ollama.internal:11434
OLLAMA_MODEL=nemotron-3-nano:30b-cloud
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Performance Configuration
UVICORN_WORKERS=4
BACKEND_TIMEOUT=120
DATABASE_TIMEOUT=30

# Monitoring Configuration
SENTRY_DSN=https://your-sentry-dsn-here
LOG_LEVEL=INFO

# Monitoring Ports (Internal Access Only)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100
ALERTMANAGER_PORT=9093

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=secure_grafana_password
GRAFANA_SECRET_KEY=grafana-secret-key-here
