{
  "id": null,
  "title": "HRAS - Human Rights Advisory System Overview",
  "tags": ["hras", "overview"],
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "HTTP Requests per Second",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(hras_http_requests_total[5m]))",
          "legendFormat": "Requests/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 10},
              {"color": "red", "value": 50}
            ]
          }
        }
      },
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "RAG Query Latency",
      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(hras_rag_query_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95 Latency"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 5},
              {"color": "red", "value": 10}
            ]
          }
        }
      },
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0}
    },
    {
      "id": 3,
      "title": "Active Chat Sessions",
      "type": "stat",
      "targets": [
        {
          "expr": "hras_chat_sessions_active",
          "legendFormat": "Active Sessions"
        }
      ],
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0}
    },
    {
      "id": 4,
      "title": "Vector Store Documents",
      "type": "stat",
      "targets": [
        {
          "expr": "hras_vectorstore_documents",
          "legendFormat": "Documents"
        }
      ],
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0}
    },
    {
      "id": 5,
      "title": "HTTP Request Rate by Status",
      "type": "graph",
      "targets": [
        {
          "expr": "sum(rate(hras_http_requests_total[5m])) by (status_code)",
          "legendFormat": "{{status_code}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "id": 6,
      "title": "RAG Query Success Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "sum(rate(hras_rag_queries_total{status=\"success\"}[5m])) / sum(rate(hras_rag_queries_total[5m])) * 100",
          "legendFormat": "Success Rate %"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    },
    {
      "id": 7,
      "title": "Model Inference Duration",
      "type": "graph",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(hras_model_inference_duration_seconds_bucket[5m])) by (le, model))",
          "legendFormat": "{{model}} P95"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(hras_model_inference_duration_seconds_bucket[5m])) by (le, model))",
          "legendFormat": "{{model}} P50"
        }
      ],
      "yAxes": [
        {
          "unit": "s"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}
    },
    {
      "id": 8,
      "title": "Vector Search Performance",
      "type": "graph",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(hras_vector_search_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "Search P95"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(hras_vector_search_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "Search P50"
        }
      ],
      "yAxes": [
        {
          "unit": "s"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}
    },
    {
      "id": 9,
      "title": "Agent Workflow Success Rate",
      "type": "graph",
      "targets": [
        {
          "expr": "sum(rate(hras_agent_executions_total{status=\"success\"}[5m])) by (agent_name) / sum(rate(hras_agent_executions_total[5m])) by (agent_name) * 100",
          "legendFormat": "{{agent_name}} Success %"
        }
      ],
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24}
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "5s",
  "schemaVersion": 27,
  "version": 0
}
