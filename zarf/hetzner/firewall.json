{
    "name": "hras-web-firewall",
    "labels": {
        "application": "HRAS",
        "environment": "production",
        "provider": "hetzner"
    },
    "rules": [
        {
            "direction": "in",
            "protocol": "tcp",
            "port": "22",
            "source_ips": ["0.0.0.0/0", "::/0"],
            "description": "SSH access"
        },
        {
            "direction": "in",
            "protocol": "tcp",
            "port": "80",
            "source_ips": ["0.0.0.0/0", "::/0"],
            "description": "HTTP for Caddy ACME and redirects"
        },
        {
            "direction": "in",
            "protocol": "tcp",
            "port": "443",
            "source_ips": ["0.0.0.0/0", "::/0"],
            "description": "HTTPS for public API access"
        },
        {
            "direction": "out",
            "protocol": "icmp",
            "destination_ips": ["0.0.0.0/0", "::/0"],
            "description": "Outbound ICMP"
        },
        {
            "direction": "out",
            "protocol": "tcp",
            "port": "1-65535",
            "destination_ips": ["0.0.0.0/0", "::/0"],
            "description": "Outbound TCP"
        },
        {
            "direction": "out",
            "protocol": "udp",
            "port": "1-65535",
            "destination_ips": ["0.0.0.0/0", "::/0"],
            "description": "Outbound UDP"
        }
    ]
}
