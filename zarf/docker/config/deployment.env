# HRAS Deployment Configuration
# Copy this file to deployment.env and modify for your environment

# AWS Configuration
AWS_REGION=us-east-1
EC2_INSTANCE_ID=i-0123456789abcdef0
EC2_SSH_KEY_PATH=~/.ssh/hras-deploy-key.pem
EC2_USER=ubuntu
EC2_HOST=your-ec2-instance.compute-1.amazonaws.com

# Domain and SSL Configuration
DOMAIN=hras.example.com
EMAIL=admin@example.com
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
ROUTE53_HOSTED_ZONE_ID=Z1234567890ABC

# Application Configuration
APP_NAME=hras
APP_VERSION=latest
DOCKER_REGISTRY=ghcr.io/yourusername
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Database Configuration
DATABASE_URL=postgresql+asyncpg://hras:secure_password@localhost:5432/hras
POSTGRES_DB=hras
POSTGRES_USER=hras
POSTGRES_PASSWORD=secure_password_here

# SSL Configuration
SSL_PROVIDER=letsencrypt  # Options: letsencrypt, cloudflare
SSL_CHALLENGE=dns         # Options: http, dns

# Monitoring Configuration
GRAFANA_ADMIN_PASSWORD=secure_grafana_password
PROMETHEUS_RETENTION_TIME=15d
ALERTMANAGER_WEBHOOK_URL=https://hooks.slack.com/your-webhook-url

# Backup Configuration
BACKUP_RETENTION_DAYS=30
S3_BACKUP_BUCKET=hras-backups-your-org
S3_BACKUP_PREFIX=production

# Feature Flags
USE_POSTGRES=true
USE_ASYNC_TOOLS=true
USE_REDIS_CACHE=true
ENABLE_MONITORING=true
ENABLE_ALERTING=true

# Security Configuration
ALLOWED_HOSTS=localhost,127.0.0.1,${DOMAIN}
CORS_ORIGINS=https://${DOMAIN}
SECRET_KEY=your_very_secure_secret_key_here

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nemotron-3-nano:30b-cloud
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Vector Store Configuration
CHROMA_PERSIST_DIRECTORY=/data/chroma_db

# Deployment Options
DEPLOYMENT_STRATEGY=rolling  # Options: rolling, blue-green
HEALTH_CHECK_TIMEOUT=300
ROLLBACK_ON_FAILURE=true
BACKUP_BEFORE_DEPLOY=true
