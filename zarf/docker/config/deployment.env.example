# HRAS Production Deployment Example Configuration
# Copy this file to deployment.env and modify for your environment

# =============================================================================
# AWS Configuration
# =============================================================================
AWS_REGION=us-east-1
EC2_INSTANCE_ID=i-0123456789abcdef0
EC2_SSH_KEY_PATH=~/.ssh/hras-deploy-key.pem
EC2_USER=ubuntu
EC2_HOST=hras.example.com

# =============================================================================
# Domain and SSL Configuration
# =============================================================================
DOMAIN=hras.example.com
EMAIL=admin@example.com

# SSL Provider Options: letsencrypt, cloudflare
SSL_PROVIDER=letsencrypt

# SSL Challenge Options: http, dns
# DNS challenge recommended for production (supports wildcards)
SSL_CHALLENGE=dns

# Route53 Configuration (required for DNS challenge)
ROUTE53_HOSTED_ZONE_ID=Z1234567890ABC

# Cloudflare Configuration (if using Cloudflare SSL)
# CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# =============================================================================
# Application Configuration
# =============================================================================
APP_NAME=hras
APP_VERSION=latest
DOCKER_REGISTRY=ghcr.io/yourusername
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=postgresql+asyncpg://hras:CHANGE_ME_SECURE_PASSWORD@localhost:5432/hras
POSTGRES_DB=hras
POSTGRES_USER=hras
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# =============================================================================
# Security Configuration
# =============================================================================
SECRET_KEY=CHANGE_ME_VERY_SECURE_SECRET_KEY_32_CHARS_MIN
ALLOWED_HOSTS=localhost,127.0.0.1,hras.example.com
CORS_ORIGINS=https://hras.example.com

# =============================================================================
# Deployment Options
# =============================================================================
DEPLOYMENT_STRATEGY=rolling
HEALTH_CHECK_TIMEOUT=300
ROLLBACK_ON_FAILURE=true
BACKUP_BEFORE_DEPLOY=true

# =============================================================================
# Monitoring Configuration
# =============================================================================
ENABLE_MONITORING=true
ENABLE_ALERTING=true
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_SECURE_GRAFANA_PASSWORD
PROMETHEUS_RETENTION_TIME=15d

# Alerting Webhook (Slack, Discord, etc.)
# ALERTMANAGER_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# =============================================================================
# Backup Configuration
# =============================================================================
BACKUP_RETENTION_DAYS=30
S3_BACKUP_BUCKET=hras-backups-your-organization
S3_BACKUP_PREFIX=production

# =============================================================================
# Feature Flags
# =============================================================================
USE_POSTGRES=true
USE_ASYNC_TOOLS=true
USE_REDIS_CACHE=true

# =============================================================================
# AI/ML Configuration
# =============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nemotron-3-nano:30b-cloud
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# =============================================================================
# Vector Store Configuration
# =============================================================================
CHROMA_PERSIST_DIRECTORY=/data/chroma_db

# =============================================================================
# IMPORTANT SECURITY NOTES
# =============================================================================
# 1. Replace ALL "CHANGE_ME" values with secure, random passwords
# 2. Use a proper domain name that you own
# 3. Configure DNS records to point to your EC2 instance
# 4. Set up proper AWS IAM permissions for S3 and Route53
# 5. Store this file securely and never commit it to version control
# 6. Use environment-specific configurations for different stages
