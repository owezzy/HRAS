[Unit]
Description=HRAS - Human Rights Advisory System
Documentation=https://github.com/owezzy/HRAS
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/hras
EnvironmentFile=/opt/hras/.env.prod

ExecStartPre=/usr/bin/docker compose -f zarf/docker/compose/docker-compose.prod.yml pull
ExecStart=/usr/bin/docker compose -f zarf/docker/compose/docker-compose.prod.yml --env-file .env.prod up -d
ExecStop=/usr/bin/docker compose -f zarf/docker/compose/docker-compose.prod.yml down
ExecReload=/usr/bin/docker compose -f zarf/docker/compose/docker-compose.prod.yml --env-file .env.prod up -d --force-recreate

Restart=on-failure
RestartSec=30
TimeoutStartSec=300
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
